# Copy to .env and adjust. Never commit real keys.
# LLM provider: mock (default, offline) | openai | groq | ollama
IC_PROVIDER=mock
IC_BASE_URL=https://api.openai.com/v1
IC_MODEL=gpt-4o-mini
IC_API_KEY=
# Investigation step cap
IC_MAX_STEPS=20

# ---- HTTP service (incident-commander serve) ----
# No keys + IC_DEV_MODE unset = public demo (packaged scenarios, mock provider, simulated runbooks).
# Comma-separated keys. Responders open/follow incidents; approvers can also approve/reject.
IC_API_KEYS=
IC_APPROVER_KEYS=
# Local development only: no authentication at all.
IC_DEV_MODE=false
IC_CORS_ORIGINS=
IC_RATE_LIMIT_PER_MINUTE=120
IC_INCIDENT_LIMIT_PER_MINUTE=6
IC_MAX_CONCURRENT_RUNS=2
IC_MAX_QUEUED_RUNS=8
IC_MAX_INCIDENTS_KEPT=200
IC_MAX_STEPS_CAP=30
# Set only behind a reverse proxy you control (uses the right-most X-Forwarded-For hop).
IC_TRUST_PROXY=false
# Run investigations inside the request (auto-on when VERCEL or AWS_LAMBDA_FUNCTION_NAME is set).
IC_SYNC_RUNS=
