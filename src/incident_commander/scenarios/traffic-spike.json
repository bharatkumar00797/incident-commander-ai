        "description": "Public API gateway"
      },
      "ticketing-api": {
        "depends_on": [
          "inventory-db"
        ],
        "owner": "team-ticketing",
        "description": "Seat holds and ticket purchases"
      },
      "inventory-db": {
        "owner": "team-dba",
        "description": "Seat inventory database"
      }
    }
  },
